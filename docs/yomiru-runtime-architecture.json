  "cards": [
    {
      "dot": "cyan",
      "title": "主请求路径",
      "items": [
        "功能页通过 LKApi 进程内门面调用 LKClient",
        "LKClient 统一向 lightnovel.fun/api/pc-proxy 发送 HTTPS POST + JSON"
      ]
    },
    {
      "dot": "emerald",
      "title": "本地性能路径",
      "items": [
        "公开只读响应进入内存与 SharedPreferences 缓存",
        "阅读器优先显示正文缓存，异步解析并预取下一章",
        "头像、勋章和通用图片由独立 CacheManager 复用"
      ]
    },
    {
      "dot": "rose",
      "title": "会话与失效处理",
      "items": [
        "security_key 仅持久化到 Android Keystore / iOS Keychain",
        "服务端判定会话失效时清空本地会话与账号缓存，再通知 UI",
        "匿名打开上报与更新检查均不阻塞应用首屏"
      ]
    }
